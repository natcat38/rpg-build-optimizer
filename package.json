{
  "name": "rpg-build-optimizer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.api.json",
    "build:data": "tsx scripts/build-dataset.ts",
    "bench": "tsx scripts/benchmark.ts",
    "docs:check": "tsx scripts/check-docs.ts",
    "meta:coverage": "tsx scripts/meta-coverage.ts",
    "file-map": "tsx scripts/gen-file-map.ts",
    "file-map:check": "tsx scripts/gen-file-map.ts --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vercel/node": "^5.9.6",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "genshin-db": "^5.2.12",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
