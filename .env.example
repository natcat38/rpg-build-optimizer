# Copy to .env.local (never commit that file) and fill in real values.
# Only the AI-explain feature reads any of these; the app itself runs without them.

# Anthropic key for the /api/explain serverless proxy. Server-side only — it
# must never be exposed to the browser bundle, so no VITE_ prefix.
ANTHROPIC_API_KEY=

# Build-time flag that renders the "Explain this build" button. Keep it off
# until the key above is deployed.
VITE_AI_ENABLED=

# Upstash Redis REST credentials for the rate limiter (ADR-0013). Required in
# production — unset there, /api/explain refuses every request with 503.
# Optional locally and in CI, where the limiter is a logged no-op.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional extra Origin the /api/explain endpoint accepts. It already accepts
# its own deployment origin; set this only when serving from a custom domain.
PUBLIC_ORIGIN=
